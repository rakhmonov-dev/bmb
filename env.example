# =====================================================================
# BMG SCHOOL BACKEND — Environment Variables
# Bu faylni .env deb nomlab, haqiqiy qiymatlarni kiriting.
# .env faylini HECH QACHON Git'ga yuklamang (.gitignore'da bor).
# =====================================================================

# ------------------- SERVER -------------------
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# ------------------- DATABASE (MySQL) -------------------
# Lokal ishlab chiqish uchun:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bmg_school

# Railway MySQL uchun deploy qilganda Railway avtomatik quyidagilarni beradi:
# DB_HOST=containers-us-west-XX.railway.app
# DB_PORT=XXXX
# DB_USER=root
# DB_PASSWORD=<Railway tomonidan berilgan>
# DB_NAME=railway

DB_CONNECTION_LIMIT=10
# Aiven (yoki boshqa cloud MySQL) uchun SSL majburiy:
DB_SSL=true
# Ixtiyoriy — Aiven'dan yuklab olingan ca.pem fayl yo'li (qat'iy tekshirish uchun):
# DB_SSL_CA_PATH=./certs/ca.pem

# ------------------- JWT AUTH -------------------
# Kuchli, tasodifiy qiymat kiriting (masalan: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_very_long_random_secret_string_before_production
JWT_EXPIRES_IN=8h

# ------------------- CORS -------------------
# Frontend manzili (Vercel'ga deploy qilgandan keyin haqiqiy domenni kiriting)
FRONTEND_URL=http://localhost:5173

# ------------------- OPENAI (AI Support Chat) -------------------
# Agar bo'sh qoldirilsa, chat avtomatik keyword-fallback rejimiga o'tadi
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------- FILE UPLOADS (Cloudflare R2) -------------------
# Fayllar endi diskka emas, Cloudflare R2'ga yuklanadi (Render'ning disklari
# doimiy emas). Bucket yarating: dash.cloudflare.com > R2 > Create bucket,
# "Public access" yoqing (yoki custom domen ulang) va API token oling:
# R2 > Manage API tokens > Create API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Bucket'ning ommaviy manzili (oxirida "/" bo'lmasin):
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

MAX_UPLOAD_SIZE_MB=5
# Galereya uchun alohida, kattaroq limit — video fayllar rasmlardan
# ancha katta bo'ladi (dars/tadbir videolarini yuklash uchun).
MAX_GALLERY_UPLOAD_SIZE_MB=100
UPLOAD_DIR=uploads

# ------------------- RATE LIMITING -------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
AI_CHAT_RATE_LIMIT_MAX=20
